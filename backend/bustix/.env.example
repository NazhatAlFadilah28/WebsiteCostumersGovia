# -----------------------------------------------------------------------------
# BUSTIX BACKEND ENVIRONMENT CONFIGURATION (TEMPLATE)
# -----------------------------------------------------------------------------
# Salin file ini menjadi `.env` di folder backend/bustix/ lalu isi nilainya.

PORT=3000
NODE_ENV=development

# Supabase PostgreSQL Connection String
DATABASE_URL="postgresql://postgres:<PASSWORD>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Supabase Credentials
SUPABASE_URL="https://<PROJECT_REF>.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# JWT Secret
JWT_SECRET="change-this-to-a-strong-random-secret"

# Midtrans Payment Gateway Configuration
MIDTRANS_SERVER_KEY="Mid-server-XXXXX"
MIDTRANS_CLIENT_KEY="Mid-client-XXXXX"
MIDTRANS_IS_PRODUCTION=false

# Google Gemini AI Configuration (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3-flash-preview

# WhatsApp Chat Bot (Baileys - backend/wa-service)
WA_SERVICE_URL=http://localhost:3002
WA_SERVICE_API_KEY=bustix-wa-secret-key
WA_AUTO_SEND_TICKET=true

# TomTom Maps & Routing API
TOMTOM_API_KEY=your-tomtom-api-key

# TikTok Login Kit OAuth API
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret

# SMTP Email (OTP Login)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

