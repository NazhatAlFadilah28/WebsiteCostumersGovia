# -----------------------------------------------------------------------------
# BUSTIX WHATSAPP BOT (Baileys) - ENVIRONMENT CONFIGURATION
# -----------------------------------------------------------------------------
# Salin file ini menjadi `.env` lalu sesuaikan nilainya.

# Port microservice WhatsApp Bot
WA_PORT=3002

# Kunci rahasia yang harus dikirim backend BusTix pada header `x-api-key`
# WAJIB sama dengan WA_SERVICE_API_KEY di backend/bustix/.env
WA_API_KEY=bustix-wa-secret-key

# Alamat backend Next.js BusTix (tempat ambil data tiket & AI chatbot)
BACKEND_URL=http://localhost:3000

# Folder penyimpanan sesi login WhatsApp (berisi kredensial hasil scan QR).
# JANGAN di-commit ke Git. Hapus folder ini bila ingin login ulang.
WA_AUTH_DIR=./auth_info

# Nama bot yang tampil di pesan
WA_BOT_NAME=BusTix Assistant

# Matikan balasan otomatis (set false) bila hanya ingin mode kirim satu arah
WA_AUTO_REPLY=true
